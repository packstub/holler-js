{
    "name": "@packstub/holler",
    "version": "0.1.0",
    "description": "WebRTC calls (audio, video, screen share), 1-on-1 and small groups over a mesh, with a pluggable signaling backend and topology, plus a ready-made call widget. Framework-agnostic; the engine behind packstub/holler and packstub/filament-holler.",
    "type": "module",
    "main": "src/index.js",
    "module": "src/index.js",
    "exports": {
        ".": {
            "types": "./src/index.d.ts",
            "default": "./src/index.js"
        },
        "./widget": {
            "types": "./src/widget.d.ts",
            "default": "./src/widget.js"
        },
        "./widget.css": "./src/widget.css",
        "./package.json": "./package.json"
    },
    "files": [
        "src",
        "CHANGELOG.md"
    ],
    "keywords": [
        "webrtc",
        "video-call",
        "voice-call",
        "screen-share",
        "peer-to-peer",
        "group-call",
        "mesh",
        "signaling",
        "perfect-negotiation",
        "widget"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/packstub/holler-js"
    },
    "homepage": "https://github.com/packstub/holler-js",
    "bugs": "https://github.com/packstub/holler-js/issues",
    "author": "Ion Caliman <icaliman92@gmail.com>",
    "license": "MIT",
    "sideEffects": [
        "*.css"
    ],
    "engines": {
        "node": ">=20"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "test:types": "tsc -p tests/types"
    },
    "devDependencies": {
        "jsdom": "^29.1.1",
        "typescript": "^5.6.3",
        "vitest": "^3.2.4"
    },
    "types": "src/index.d.ts"
}
