{
    "name": "@packstub/calls",
    "version": "0.1.0",
    "description": "WebRTC calls (audio, video, screen share), 1-on-1 and small groups over a mesh, with a pluggable signaling backend and topology, plus a ready-made call widget. Framework-agnostic; the engine behind packstub/calls and packstub/filament-calls.",
    "type": "module",
    "main": "src/index.js",
    "module": "src/index.js",
    "exports": {
        ".": "./src/index.js",
        "./widget": "./src/widget.js",
        "./widget.css": "./src/widget.css",
        "./package.json": "./package.json"
    },
    "files": [
        "src",
        "CHANGELOG.md"
    ],
    "keywords": [
        "webrtc",
        "video-call",
        "voice-call",
        "screen-share",
        "peer-to-peer",
        "group-call",
        "mesh",
        "signaling",
        "perfect-negotiation",
        "widget"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/packstub/calls-js"
    },
    "homepage": "https://github.com/packstub/calls-js",
    "bugs": "https://github.com/packstub/calls-js/issues",
    "author": "Ion Caliman <icaliman92@gmail.com>",
    "license": "MIT",
    "sideEffects": [
        "*.css"
    ],
    "engines": {
        "node": ">=20"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "jsdom": "^29.1.1",
        "vitest": "^3.2.4"
    }
}
